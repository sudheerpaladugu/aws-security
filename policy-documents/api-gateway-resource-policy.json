{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": "*",
      "Action": "execute-api:Invoke",
      "Resource": "arn:aws:execute-api:*"
    },
    {
      "Effect": "Deny",
      "Principal": "*",
      "Action": "execute-api:Invoke",
      "Resource": "arn:aws:execute-api:*",
      "Condition": {
        "StringNotEquals": {
          "aws:SourceVpc": [
            "vpc-1234c3d4e5f6g7h89"
          ]
        }        
      }
    }
  ]
}
