{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvalidateTemporarySecurityCredentials",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "DateLessThan": {
          "aws:TokenIssueTime": "2026-02-24T20:40:00Z"
        }
      }
    }
  ]
}
